{
  "name": "devlog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub 푸시 기록을 정리해 발행하는 개발 일지 (Eleventy)",
  "scripts": {
    "start": "eleventy --serve --incremental",
    "dev": "eleventy --serve --incremental",
    "build": "eleventy",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('_site',{recursive:true,force:true}))\"",
    "digest": "node tools/push-digest.mjs",
    "watch:vendors": "node tools/vendor-watch.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
