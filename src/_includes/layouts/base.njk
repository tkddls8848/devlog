<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ summary or site.tagline }}" />
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}" />
  </head>
  {# 아카이브의 표는 글 폭으로는 좁습니다. 그 페이지만 넓게 씁니다. #}
  <body{% if wide %} class="wide"{% endif %}>
    <header class="site-header">
      <div class="site-brand">
        <a class="site-title" href="{{ '/' | url }}">{{ site.title }}</a>
        <p class="site-tagline">{{ site.tagline }}</p>
      </div>
      <nav class="site-nav" aria-label="주요">
        <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>개발 일지</a>
        <a href="{{ '/updates/' | url }}"{% if '/updates/' in page.url %} aria-current="page"{% endif %}>갱신 일지</a>
        <a href="{{ '/archive/' | url }}"{% if page.url == '/archive/' %} aria-current="page"{% endif %}>아카이브</a>
      </nav>
    </header>

    <main>{{ content | safe }}</main>

    <footer class="site-footer">
      <p>
        © {{ '' | year }} {{ site.githubUser }} ·
        <a href="https://github.com/{{ site.githubUser }}">GitHub</a>
      </p>
    </footer>
  </body>
</html>
