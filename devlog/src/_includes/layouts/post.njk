---
layout: layouts/base.njk
---

<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ date | isoDate }}">{{ date | postDate }}</time>
      {% if aiGenerated %}<span class="badge">AI 생성</span>{% endif %}
    </p>
    {% if summary %}<p class="post-summary">{{ summary }}</p>{% endif %}
  </header>

  {{ content | safe }}

  {% if commits %}
    <section class="sources">
      <h2>참고한 커밋</h2>
      {% for repo in commits %}
        <h3><a href="https://github.com/{{ repo.repo }}">{{ repo.repo }}</a></h3>
        <ul>
          {% for commit in repo.items %}
            <li>
              <a href="https://github.com/{{ repo.repo }}/commit/{{ commit.sha }}"><code>{{ commit.sha | shortSha }}</code></a>
              {{ commit.message }}
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    </section>
  {% endif %}

  <p class="back">
    <a href="{{ '/' | url }}">← 개발 일지</a>
  </p>
</article>
