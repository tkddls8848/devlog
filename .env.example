# 저장소 최상위 .env 한 곳에서만 관리합니다. 실제 키는 커밋하지 않습니다.
# 아래 항목은 필요한 것만 주석을 해제합니다. 셸/CI 환경변수가 우선합니다.
# GITHUB_TOKEN=
# GH_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# 이전 devlog 수집 도구용 Cloudflare 설정
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# DEVLOG_ADMIN_PASSWORD=
# VIDEO_SIZE=1280x720
# VIDEO_FPS=24

# YouTube Data API OAuth (데스크톱 앱 클라이언트). npm run auth 로 리프레시 토큰을 받는다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 내레이션: 명시한 TTS_PROVIDER 우선. 미설정이면 Gemini 키 → ElevenLabs → edge 순서.
# Gemini 사용 시 아래 주석을 해제하고 키를 설정한다.
# TTS_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Charon
# AI Studio에서 설계한 voice_... ID도 GEMINI_TTS_VOICE로 지정할 수 있다.
# GEMINI_TTS_STYLE=한국어로 차분하고 친근하게, 개발자가 동료에게 회고하듯 말한다.
# 비공개 대본은 활성 Cloud Billing이 연결된 프로젝트의 API로 생성한다.
# https://ai.google.dev/gemini-api/terms
