---
layout: layouts/base.njk
---

<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ date | isoDate }}">{{ date | issueDate }}</time>
      {% if sources %}<span>소식 {{ sources | entryCount }}건 · 출처 {{ sources | length }}곳</span>{% endif %}
      {% if aiGenerated %}<span class="badge">AI 생성</span>{% endif %}
    </p>
    {% if summary %}<p class="post-summary">{{ summary }}</p>{% endif %}
  </header>

  {{ content | safe }}

  {% if sources %}
    <section class="sources">
      <h2>오늘 읽은 소식</h2>
      {% for source in sources %}
        <h3>{{ source.source }}{% if source.kind %} <span class="meta">{{ source.kind }}</span>{% endif %}</h3>
        <ul class="links">
          {% for entry in source.entries %}
            <li>
              <a href="{{ entry.url }}" rel="noopener">{{ entry.title }}</a>
              <span class="meta">
                <time datetime="{{ entry.at | isoDate }}">{{ entry.at | clockTime }}</time>
                {% if entry.note %} · {{ entry.note }}{% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    </section>
  {% endif %}

  <p class="back">
    <a href="{{ '/' | url }}">← 뉴스레터</a>
  </p>
</article>
