{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devlog",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-24",
  // 매일 09:10 KST 작업 기록. 뉴스·아카이브 Cron은 specsheet Worker로 옮겼다. Cron Trigger는 UTC 기준이다.
  "triggers": {
    "crons": ["10 0 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devlog-news",
      "database_id": "49dde3a7-307c-463d-91bc-c2d44cf7a8e7",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "DEVLOG_URL": "https://devlog.tkddls8848.workers.dev/devlog/",
    "ARCHIVE_URL": "https://specsheet.tkddls8848.workers.dev/archive/",
    "NEWS_URL": "https://specsheet.tkddls8848.workers.dev/"
  },
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // 작업 회고 HTML과 옮긴 경로의 301은 Worker가 만들고 CSS·JS는 정적 자산으로 바로 보낸다.
    "run_worker_first": ["/", "/issues/*", "/archive*", "/devlog*", "/feed.xml", "/healthz"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
