{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devlog",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-24",
  // 매일 07:00 KST. Cron Trigger는 UTC 기준이다.
  "triggers": {
    "crons": ["0 22 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devlog-news",
      "database_id": "49dde3a7-307c-463d-91bc-c2d44cf7a8e7",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "CF_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "NEWS_WINDOW_HOURS": "24",
    "NEWS_PER_SOURCE": "3",
    "NEWS_MAX_ITEMS": "30",
    "HN_MIN_POINTS": "100",
    "DEVLOG_URL": "https://tkddls8848.github.io/devlog/",
    "ARCHIVE_URL": "https://tkddls8848.github.io/devlog/archive/"
  },
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // HTML과 RSS는 D1에서 동적으로 만들고 CSS·JS는 정적 자산으로 바로 보낸다.
    "run_worker_first": ["/", "/issues/*", "/feed.xml", "/healthz"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
