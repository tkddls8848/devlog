# YouTube Data API OAuth (데스크톱 앱 클라이언트). npm run auth 로 리프레시 토큰을 받는다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 내레이션 (npm run voice / render). 둘 다 있으면 ElevenLabs, 없으면 무료 edge-tts를 쓴다.
# 목소리 ID는 ElevenLabs Voices 화면에서 목소리를 고른 뒤 "Copy voice ID"로 얻는다.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# EDGE_TTS_VOICE=ko-KR-InJoonNeural
